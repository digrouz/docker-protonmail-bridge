#!/command/with-contenv sh

# Ensure the home/config dir is owned by appuser. A fresh PVC/emptyDir is created
# root-owned, so the gpg/pass/bridge init below (run as appuser) would fail with
# "permission denied". chown only when needed (idempotent).
if [ "$(stat -c '%u' /home/appuser 2>/dev/null || echo 0)" != "$(id -u appuser)" ]; then
    echo "Fix ownership of /home/appuser"
    chown -R appuser:appuser /home/appuser
fi

if [ "$(stat -c '%u' /opt/protonmail/etc/protontty 2>/dev/null || echo 0)" != "$(id -u appuser)" ]; then
  echo "Fix ownership of /opt/protonmail/etc/protontty"
  chown -R appuser:appuser /opt/protonmail/etc/protontty
fi
